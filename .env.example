# Telegram Bot Configuration (Obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Webhook Secret Token (Generated random string for X-Telegram-Bot-Api-Secret-Token verification)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# WhatsApp Cloud API Configuration (Meta Developer Console)
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=ims_nsut_whatsapp_verify_token

# Application Base URL
NEXT_PUBLIC_APP_URL=https://ims-app-pearl.vercel.app

# Optional Security Encryption Key for Session Guard
AUTH_TOKEN_SECRET=your_random_secret_here
